# Stripe secret key — get this from https://dashboard.stripe.com/apikeys
# Production: set in Netlify (Site settings → Environment variables) to the live key.
# Local dev: prefer `npm run dev` (= op run --env-file=.env.op -- npx netlify dev),
# which injects the sandbox key from 1Password — no real key in a plaintext file.
STRIPE_SECRET_KEY=sk_live_...

# Resend newsletter segment ID — create a "Newsletter" segment in Resend and
# set its ID in Netlify and local development. Keep the API key server-side.
RESEND_API_KEY=re_...
RESEND_NEWSLETTER_SEGMENT_ID=seg_...

# RSVP emails and secure, email-based cancellation links.
RSVP_EMAIL_FROM=Public Vinyl Radio <events@example.com>
RSVP_EMAIL_REPLY_TO=hello@example.com
RSVP_CANCELLATION_SECRET=use-a-long-random-secret-here
