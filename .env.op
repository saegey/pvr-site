# 1Password secret references for the shop sync script.
# Safe to commit — these are op:// references, not the secrets themselves.
# `op run --env-file=.env.op -- <cmd>` resolves them at runtime.
#
# Update the vault/item/field names below to match your 1Password entries,
# then verify with:  op run --env-file=.env.op -- printenv STRIPE_SECRET_KEY_SANDBOX
#
# Reference format: op://<vault>/<item>/<field>
STRIPE_SECRET_KEY_SANDBOX=op://PVR/Stripe PVR Sandbox/secret key
STRIPE_SECRET_KEY_LIVE=op://PVR/Stripe PVR Live/secret key

# Used by the local dev server's checkout API route (src/api/create-checkout.ts),
# which reads STRIPE_SECRET_KEY. Points at the sandbox key so local checkout uses
# test mode. In production, Netlify sets STRIPE_SECRET_KEY to the live key.
STRIPE_SECRET_KEY=op://PVR/Stripe PVR Sandbox/secret key


RESEND_API_KEY=op://PVR/Resend PVR/api key
ORDER_EMAIL_FROM=op://PVR/Resend PVR/from
ORDER_EMAIL_REPLY_TO=op://PVR/Resend PVR/reply to

# NOTE: Cloudflare R2 credentials live in a separate file, .env.r2.op, loaded only
# by the event scripts (event:recap, event:photos). Keeping them out of this file
# means `npm run dev` never tries to resolve them, so a missing R2 item can't block
# the dev server.
