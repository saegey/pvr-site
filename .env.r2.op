# 1Password secret references for Cloudflare R2 (event scripts only).
# Safe to commit — these are op:// references, not the secrets themselves.
# Loaded by `npm run event:recap` / `npm run event:photos` via:
#   op run --env-file=.env.r2.op -- node scripts/event-*.mts
#
# This is intentionally separate from .env.op so the everyday dev server
# (npm run dev) never tries to resolve R2 — a missing/uncreated R2 item here
# only affects the event scripts, not local development.
#
# Create the referenced item in 1Password (update vault/title to taste):
#   op item create --category "API Credential" --title "PVR R2" --vault "Homelab" \
#     "R2_ACCOUNT_ID[text]=..." "R2_ACCESS_KEY_ID[text]=..." \
#     "R2_SECRET_ACCESS_KEY[password]=..." "R2_BUCKET[text]=..." \
#     "R2_PUBLIC_BASE_URL[text]=https://pub-xxxxx.r2.dev"
# Then verify:  op run --env-file=.env.r2.op -- printenv R2_ACCOUNT_ID
#
# Reference format: op://<vault>/<item>/<field>
R2_ACCOUNT_ID=op://Homelab/PVR R2/R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=op://Homelab/PVR R2/R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=op://Homelab/PVR R2/R2_SECRET_ACCESS_KEY
R2_BUCKET=op://Homelab/PVR R2/R2_BUCKET
R2_PUBLIC_BASE_URL=op://Homelab/PVR R2/R2_PUBLIC_BASE_URL
