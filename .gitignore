node_modules/
.cache/
public

# The global ~/.gitignore has an "Icon?" rule (for macOS Icon\r files) that,
# on a case-insensitive filesystem, also matches the "icons" directory and
# silently ignores new files in src/icons/. Re-include it so SVGs get tracked.
!/src/icons/
!/src/icons/**
src/gatsby-types.d.ts
.DS_Store
**/.DS_Store
.env
# Local Netlify folder
.netlify
.env.development

# Locally generated customer order PDFs
.generated/orders/

# Shop image sources — only the generated .webp derivatives are tracked/served.
# Keep originals outside git; `npm run shop:images` reads them locally to
# regenerate webp when you drop them back into static/images/shop/<id>/.
static/images/shop/**/*.png
static/images/shop/**/*.jpg
static/images/shop/**/*.jpeg
static/images/shop/**/*.psd
