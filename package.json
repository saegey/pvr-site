{
  "name": "public-vinyl-radio-www",
  "version": "1.0.0",
  "private": true,
  "description": "Public Vinyl Radio public website",
  "author": "Adam Saegebarth <adam.saegebarth@gmail.com>",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "gatsby develop",
    "dev": "op run --env-file=.env.op -- npx netlify dev",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "shop:new": "node scripts/shop-new.mts",
    "shop:images": "node scripts/shop-images.mts",
    "shop:sync:sandbox": "op run --env-file=.env.op -- node scripts/shop-sync.mts --env=sandbox",
    "shop:sync:live": "op run --env-file=.env.op -- node scripts/shop-sync.mts --env=live",
    "shop:remove": "node scripts/shop-remove.mts",
    "shop:remove:sandbox": "op run --env-file=.env.op -- node scripts/shop-remove.mts --env=sandbox",
    "shop:remove:live": "op run --env-file=.env.op -- node scripts/shop-remove.mts --env=live",
    "shop:remove:all": "op run --env-file=.env.op -- node scripts/shop-remove.mts --env=all",
    "order:pdf:sandbox": "op run --env-file=.env.op -- node scripts/order-pdf.mts --env=sandbox",
    "order:pdf:live": "op run --env-file=.env.op -- node scripts/order-pdf.mts --env=live",
    "order:list:sandbox": "op run --env-file=.env.op -- node scripts/order-list.mts --env=sandbox",
    "order:list:live": "op run --env-file=.env.op -- node scripts/order-list.mts --env=live",
    "order:ship:sandbox": "op run --env-file=.env.op -- node scripts/order-ship.mts --env=sandbox",
    "order:ship:live": "op run --env-file=.env.op -- node scripts/order-ship.mts --env=live",
    "event:new": "node scripts/event-new.mts",
    "audio:prep": "node scripts/audio-prep.mts",
    "audio:prep:dry": "node scripts/audio-prep.mts --dry-run",
    "event:recap": "op run --env-file=.env.r2.op -- node scripts/event-recap.mts",
    "event:recap:dry": "op run --env-file=.env.r2.op -- node scripts/event-recap.mts --dry-run",
    "event:audio": "op run --env-file=.env.r2.op -- node scripts/event-audio.mts",
    "event:audio:dry": "op run --env-file=.env.r2.op -- node scripts/event-audio.mts --dry-run",
    "event:tracklist": "node scripts/event-tracklist.mts",
    "event:tracklist:dry": "node scripts/event-tracklist.mts --dry-run",
    "event:photos": "op run --env-file=.env.r2.op -- node scripts/event-photos.mts",
    "event:photos:dry": "op run --env-file=.env.r2.op -- node scripts/event-photos.mts --dry-run",
    "pvr:ig": "scripts/pxd-export.sh --format jpeg --quality 90 --width 1440 --subdir instagram",
    "pvr:web": "scripts/pxd-export.sh --format webp --quality 82 --width 1600 --subdir web"
  },
  "overrides": {
    "eslint-config-react-app": {
      "@typescript-eslint/eslint-plugin": "4.33.0",
      "@typescript-eslint/parser": "4.33.0",
      "babel-eslint": "10.1.0"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@mdx-js/react": "^2.3.0",
    "@netlify/blobs": "8.2.0",
    "@types/pdfkit": "0.17.6",
    "@types/svg-to-pdfkit": "0.1.4",
    "co-body": "6.2.0",
    "date-fns": "^4.1.0",
    "gatsby": "5.16.1",
    "gatsby-omni-font-loader": "^2.0.2",
    "gatsby-plugin-google-gtag": "5.16.0",
    "gatsby-plugin-image": "3.16.0",
    "gatsby-plugin-manifest": "5.16.0",
    "gatsby-plugin-mdx": "5.16.0",
    "gatsby-plugin-netlify": "5.1.1",
    "gatsby-plugin-react-svg": "3.3.0",
    "gatsby-plugin-remove-serviceworker": "^1.0.0",
    "gatsby-plugin-sharp": "5.16.0",
    "gatsby-plugin-sitemap": "6.16.0",
    "gatsby-remark-copy-linked-files": "6.16.0",
    "gatsby-remark-images": "7.16.0",
    "gatsby-remark-responsive-iframe": "6.16.0",
    "gatsby-remark-smartypants": "6.16.0",
    "gatsby-source-filesystem": "5.16.0",
    "gatsby-transformer-remark": "6.16.0",
    "gatsby-transformer-sharp": "5.16.0",
    "gatsby-transformer-yaml": "5.16.0",
    "pdfkit": "0.19.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-image-gallery": "^1.4.0",
    "resend": "6.22.0",
    "stripe": "22.5.0",
    "svg-to-pdfkit": "0.1.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "eslint-plugin-mdx": "^3.6.2",
    "gatsby-plugin-postcss": "6.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18 <=22"
  }
}
